return function(Harness, screens, data)
	local count = 0
	local function check(condition, message)
		assert(condition, message)
		count += 1
	end
	for _, compact in ipairs({false, true}) do
		local ctx = Harness.build(screens.Transfers, data, {compact = compact})
		ctx:input("Vicente", true)
		check(ctx.state.transferQuery == "Vicente" and ctx.refreshes == 1, "search input is committed")
		ctx:click("☆ Adicionar à observação")
		check(ctx.state.shortlist.m01 == true, "shortlist adds selected player")
		ctx = Harness.build(screens.Transfers, data, {compact = compact, state = ctx.state})
		ctx:click("★ Na lista de observação")
		check(ctx.state.shortlist.m01 == false, "shortlist removes selected player")
		ctx:click("+")
		check(ctx.state.negotiationAmount.m01 > data.market[1].value, "offer increment")
		ctx = Harness.build(screens.Transfers, data, {compact = compact, state = ctx.state})
		ctx:click("Salvar rascunho")
		check(ctx.state.offers.m01 == ctx.state.negotiationAmount.m01, "save draft preserves amount")
		ctx = Harness.build(screens.Transfers, data, {compact = compact, state = ctx.state})
		ctx:click("Descartar rascunho")
		check(ctx.state.offers.m01 == nil, "discard removes only offer draft")
		ctx:click("Goleiros")
		check(ctx.state.transferFilter == "Goleiros", "position filter state")
		ctx = Harness.build(screens.Transfers, data, {compact = compact, state = ctx.state})
		ctx:click("Limpar pesquisa e filtros")
		check(ctx.state.transferQuery == "" and ctx.state.transferFilter == "Todos", "empty search reset")

		ctx = Harness.build(screens.Customization, data, {compact = compact})
		ctx:click("Monograma")
		check(ctx.state.identity.crest == "Monograma" and ctx.appliedIdentity == 1, "crest selection applies")
		ctx:click("Safira")
		check(ctx.state.identity.primary.B == 1, "primary color")
		ctx:click("Listras")
		check(ctx.state.identity.kit == "Listras", "kit selection")
		ctx:click("Gelo")
		check(ctx.state.identity.secondary.R > 0.8, "secondary color")
		ctx:click("Restaurar identidade Aurora")
		check(ctx.state.identity.crest == "Escudo" and ctx.state.identity.kit == "Faixa", "identity reset")

		ctx = Harness.build(screens.Settings, data, {compact = compact})
		ctx:click("Movimento reduzido: desativado")
		check(ctx.state.settings.reducedMotion and ctx.appliedSettings == 1, "reduced motion applies")
		ctx:click("Econômica")
		check(ctx.state.settings.quality == "Econômica", "viewport quality")
		ctx:click("Ampliado · 115%")
		check(ctx.state.settings.textScale == 1.15, "text accessibility scale")
		ctx:click("Desligado")
		check(ctx.state.settings.menuVolume == 0, "menu audio can be muted")
		ctx:click("Alto")
		check(ctx.state.settings.menuVolume == 0.6, "menu audio volume applies")
		ctx:click("Testar som do menu")
		check(ctx.audioTests == 1, "menu audio test calls native audio service")
		ctx:click("Restaurar preferências")
		check(not ctx.state.settings.reducedMotion and ctx.state.settings.quality == "Alta" and ctx.state.settings.textScale == 1 and ctx.state.settings.menuVolume == 0.3, "preferences reset")
	end
	print(string.format("Screen interaction checks passed: %d (mock UI, desktop + compact; not Studio)", count))
end
